# Copy this file to .env (same folder) and fill in your name and the two free keys.
# The brain (Qwen 3 8B) and speech recognition run on your PC. Her voice, web answers and Tamil understanding
# use free online services (see the setup guide).

# ---- You and her
JARVIS_USER=YourName
ASSISTANT_NAME=Keena

# ---- Local brain (Ollama). Pull the model first:  ollama pull qwen3:8b
# Less than 8 GB of VRAM? qwen3:4b-instruct works, but she gets noticeably less smart.
JARVIS_MODEL=qwen3:8b
CONTEXT_TOKENS=4096
OLLAMA_HOST=http://127.0.0.1:11434
USE_MMAP=0

# ---- Hearing (faster-whisper, local, on the GPU)
WHISPER_MODEL=small.en
# cuda = NVIDIA GPU (fast). AMD / Intel graphics: set cpu (about 1-1.5 s slower per command)
WHISPER_DEVICE=cuda
# How she hears her name: whisper (recommended) | model | both
WAKE_MODE=whisper
# After she replies, keep listening this many seconds for a follow-up (no wake word needed)
FOLLOW_UP_SECONDS=6
# Mic loudness that counts as speaking, and the quiet that ends your sentence.
# Run  python main.py --mic-test  to see your levels.
SILENCE_RMS=500
SILENCE_SECONDS=0.7
# Which microphone. Empty = Windows default.
MIC_DEVICE=

# ---- Her voice (edge-tts, needs internet). Others: en-US-EmmaNeural, en-IN-NeerjaNeural, en-GB-SoniaNeural
JARVIS_VOICE=en-US-AvaNeural
VOICE_RATE=+0%

# ---- Free keys (optional but recommended)
# Web answers ("what's the latest...", movie picks): free key from langsearch.com
LANGSEARCH_API_KEY=
# Understanding Tamil / Tanglish speech: free key from aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Your email domains, so misheard addresses get fixed ("bdgstudio" -> yourcompany.com). Comma separated.
KNOWN_EMAIL_DOMAINS=

# ---- Browser control (her own Chrome window) and phone remote
BROWSER_CONTROL=1
REMOTE=1
REMOTE_LAN=1

# ---- Save every conversation locally in data/jarvis.db (never leaves your PC). 0 = off.
LOG_CONVERSATIONS=1

# Hide harmless download warnings
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_VERBOSITY=error
